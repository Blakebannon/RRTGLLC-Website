# Copy to .env.local for local development. All variables are optional.
# In Cloudflare Pages, set these under Settings → Variables and Secrets (build-time).
# NEXT_PUBLIC_* values are embedded in the static output and are public by design;
# never put secrets in them.

# Canonical production origin, no trailing slash. Used for canonical URLs,
# Open Graph URLs, sitemap.xml, robots.txt and structured data.
NEXT_PUBLIC_SITE_URL=https://redrockstechnologygroup.com

# Cloudflare Web Analytics site token (cookieless). Leave empty to disable,
# or leave empty if Web Analytics is enabled automatically in the Pages dashboard.
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
